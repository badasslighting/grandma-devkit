{
  "name": "grandma-devkit",
  "displayName": "Devkit for Grand MA2+MA3",
  "description": "Write Lua plugins for grandMA3 and grandMA2: API completion, hover and signature help, lint checks, plugin scaffolding, one-command deploy, and run-on-console through a LuaBridge.",
  "version": "0.4.3",
  "publisher": "badasslighting",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": { "type": "git", "url": "https://github.com/badasslighting/grandma-devkit.git" },
  "bugs": { "url": "https://github.com/badasslighting/grandma-devkit/issues" },
  "homepage": "https://github.com/badasslighting/grandma-devkit#readme",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Snippets", "Linters"],
  "keywords": ["grandMA3", "grandMA2", "MA3", "MA2", "gma", "lua", "lighting", "plugin"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lua", "onLanguage:gma2macro", "onLanguage:gma3macro", "onLanguage:xml", "workspaceContains:**/*.lua", "workspaceContains:**/*.gma2macro", "workspaceContains:**/*.gma3macro"],
  "extensionPack": ["sumneko.lua"],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "node test/ui/runTest.js",
    "build-api": "node scripts/build-api.js",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "languages": [
      { "id": "lua", "extensions": [".lua"], "aliases": ["Lua"] },
      { "id": "gma2macro", "extensions": [".gma2macro"], "aliases": ["grandMA2 Macro"], "configuration": "./language-configuration-macro.json" },
      { "id": "gma3macro", "extensions": [".gma3macro"], "aliases": ["grandMA3 Macro"], "configuration": "./language-configuration-macro.json" }
    ],
    "snippets": [{ "language": "lua", "path": "./snippets/lua.json" }],
    "configurationDefaults": {
      "[lua]": { "editor.quickSuggestions": { "other": true, "comments": false, "strings": true } }
    },
    "commands": [
      { "command": "ma3.newPlugin", "title": "New Plugin", "category": "grandMA" },
      { "command": "ma3.deploy", "title": "Deploy Plugin to Plugins Folder", "category": "grandMA" },
      { "command": "ma3.newPluginMa2", "title": "New grandMA2 Plugin", "category": "grandMA" },
      { "command": "ma3.exportToUsb", "title": "Export Plugin to USB Stick", "category": "grandMA" },
      { "command": "ma3.packagePlugin", "title": "Bump Version and Package Plugin (zip)", "category": "grandMA" },
      { "command": "ma3.deployAndRun", "title": "Deploy and Reload on Console", "category": "grandMA" },
      { "command": "ma3.importHelpLua", "title": "Import API from HelpLua File", "category": "grandMA" },
      { "command": "ma3.copyImportCommand", "title": "Copy Import Command for Plugin", "category": "grandMA" },
      { "command": "ma3.runOnConsole", "title": "Run File or Selection on Console", "category": "grandMA" },
      { "command": "ma3.objects.refresh", "title": "Refresh Object Browser", "category": "grandMA", "icon": "$(refresh)" },
      { "command": "ma3.objects.switch", "title": "Switch Object Browser Between grandMA3 and grandMA2", "category": "grandMA", "icon": "$(arrow-swap)" },
      { "command": "ma3.objects.copyPath", "title": "Copy Lua Path", "category": "grandMA" },
      { "command": "ma3.objects.showProperties", "title": "Show Properties", "category": "grandMA" },
      { "command": "ma3.objects.copyAddress", "title": "Copy Address", "category": "grandMA" },
      { "command": "ma3.objects.insertPath", "title": "Insert Lua Path at Cursor", "category": "grandMA" },
      { "command": "ma3.telnet.send", "title": "Send Command to Console (Telnet)", "category": "grandMA" },
      { "command": "ma3.telnet.sendSelection", "title": "Send Selected Lines to Console as Commands (Telnet)", "category": "grandMA" },
      { "command": "ma3.runLuaTests", "title": "Run Lua Tests in This File on Console", "category": "grandMA" },
      { "command": "ma3.updateApiFromConsole", "title": "Update API from Console (grandMA3)", "category": "grandMA" },
      { "command": "ma3.checkMa2Api", "title": "Check grandMA2 API List Against Console", "category": "grandMA" },
      { "command": "ma3.setupLanguageServer", "title": "Set Up Lua Language Server Definitions", "category": "grandMA" },
      { "command": "ma3.osc.send", "title": "Send Command to Console (OSC)", "category": "grandMA" },
      { "command": "ma3.osc.sendSelection", "title": "Send Selected Lines to Console as Commands (OSC)", "category": "grandMA" },
      { "command": "ma3.osc.setup", "title": "Enable OSC Command Input on Console", "category": "grandMA" },
      { "command": "ma3.osc.disable", "title": "Disable OSC Command Input on Console", "category": "grandMA" },
      { "command": "ma3.telnet.setPassword", "title": "Set Telnet Password", "category": "grandMA" },
      { "command": "ma3.telnet.monitor", "title": "Start Console Monitor (Telnet)", "category": "grandMA" },
      { "command": "ma3.telnet.stopMonitor", "title": "Stop Console Monitor", "category": "grandMA" },
      { "command": "ma3.installBridge", "title": "Install LuaBridge on Console", "category": "grandMA" },
      { "command": "ma3.refreshShow", "title": "Refresh Show Objects for Completion", "category": "grandMA" },
      { "command": "ma3.bridgeStatus", "title": "LuaBridge Status", "category": "grandMA" },
      { "command": "ma3.bridgeReset", "title": "LuaBridge: Clear Globals", "category": "grandMA" },
      { "command": "ma3.vars.replaceRange", "title": "Replace Variables Across a Range ($color1 thru $color5)", "category": "grandMA" },
      { "command": "ma3.vars.preview", "title": "Preview What This Command Line Runs (Variables Expanded)", "category": "grandMA" },
      { "command": "ma3.vars.inline", "title": "Replace Variable With Its Value", "category": "grandMA" },
      { "command": "ma3.vars.extract", "title": "Extract Selection to a Variable", "category": "grandMA" },
      { "command": "ma3.vars.convert", "title": "Convert Variables and Conditions to the Other Console", "category": "grandMA" },
      { "command": "ma3.vars.refresh", "title": "Refresh Console Variables", "category": "grandMA", "icon": "$(refresh)" },
      { "command": "ma3.vars.set", "title": "Set Console Variable", "category": "grandMA" },
      { "command": "ma3.vars.add", "title": "Add Console Variable", "category": "grandMA", "icon": "$(add)" },
      { "command": "ma3.vars.delete", "title": "Delete Console Variable", "category": "grandMA" },
      { "command": "ma3.vars.copyName", "title": "Copy Variable Name", "category": "grandMA" },
      { "command": "ma3.vars.watch", "title": "Watch Console Variables", "category": "grandMA" },
      { "command": "ma3.vars.stopWatch", "title": "Stop Watching Variables", "category": "grandMA" },
      { "command": "ma3.vars.snapshot", "title": "Snapshot Console Variables", "category": "grandMA" },
      { "command": "ma3.vars.diff", "title": "Compare Console Variables With Snapshot", "category": "grandMA" },
      { "command": "ma3.vars.restore", "title": "Restore Console Variables From Snapshot", "category": "grandMA" },
      { "command": "ma3.bank.refresh", "title": "Refresh Variable Bank", "category": "grandMA", "icon": "$(refresh)" },
      { "command": "ma3.bank.favorite", "title": "Add Variable to Favorites", "category": "grandMA" },
      { "command": "ma3.bank.unfavorite", "title": "Remove Variable From Favorites", "category": "grandMA" },
      { "command": "ma3.bank.editFavorite", "title": "Edit Favorite Variable (Value and Note)", "category": "grandMA" },
      { "command": "ma3.bank.reveal", "title": "Show Where a Variable Is Used", "category": "grandMA" },
      { "command": "ma3.bank.insert", "title": "Insert Variable (Favorites and Most Used First)", "category": "grandMA" },
      { "command": "ma3.bank.export", "title": "Export Favorite Variables to a File", "category": "grandMA" },
      { "command": "ma3.bank.import", "title": "Import Favorite Variables From a File", "category": "grandMA" },
      { "command": "ma3.bank.applyFavorites", "title": "Set Favorite Variables on the Console", "category": "grandMA" }
    ],
    "views": {
      "explorer": [
        { "id": "ma3.objects", "name": "grandMA3 Objects" },
        { "id": "ma3.vars", "name": "Console Variables" },
        { "id": "ma3.varbank", "name": "Variable Bank" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "ma3.objects.switch", "when": "view == ma3.objects", "group": "navigation@1" },
        { "command": "ma3.objects.refresh", "when": "view == ma3.objects", "group": "navigation@2" },
        { "command": "ma3.vars.refresh", "when": "view == ma3.vars", "group": "navigation@1" },
        { "command": "ma3.vars.add", "when": "view == ma3.vars", "group": "navigation@2" },
        { "command": "ma3.bank.refresh", "when": "view == ma3.varbank", "group": "navigation@1" },
        { "command": "ma3.bank.favorite", "when": "view == ma3.varbank", "group": "navigation@2" },
        { "command": "ma3.bank.insert", "when": "view == ma3.varbank", "group": "navigation@3" },
        { "command": "ma3.bank.import", "when": "view == ma3.varbank", "group": "1_file@1" },
        { "command": "ma3.bank.export", "when": "view == ma3.varbank", "group": "1_file@2" },
        { "command": "ma3.bank.applyFavorites", "when": "view == ma3.varbank", "group": "2_console@1" }
      ],
      "view/item/context": [
        { "command": "ma3.objects.showProperties", "when": "view == ma3.objects && viewItem == ma3object", "group": "ma3@0" },
        { "command": "ma3.objects.copyPath", "when": "view == ma3.objects && viewItem == ma3object", "group": "ma3@1" },
        { "command": "ma3.objects.copyAddress", "when": "view == ma3.objects && viewItem == ma3object", "group": "ma3@2" },
        { "command": "ma3.objects.insertPath", "when": "view == ma3.objects && viewItem == ma3object", "group": "ma3@3" },
        { "command": "ma3.vars.set", "when": "view == ma3.vars && viewItem == ma3var", "group": "ma3@0" },
        { "command": "ma3.vars.delete", "when": "view == ma3.vars && viewItem == ma3var", "group": "ma3@1" },
        { "command": "ma3.vars.copyName", "when": "view == ma3.vars && (viewItem == ma3var || viewItem == ma3varsystem)", "group": "ma3@2" },
        { "command": "ma3.vars.watch", "when": "view == ma3.vars && viewItem == ma3varconsole", "group": "ma3@3" },
        { "command": "ma3.vars.snapshot", "when": "view == ma3.vars && viewItem == ma3varconsole", "group": "ma3@4" },
        { "command": "ma3.vars.diff", "when": "view == ma3.vars && viewItem == ma3varconsole", "group": "ma3@5" },
        { "command": "ma3.vars.restore", "when": "view == ma3.vars && viewItem == ma3varconsole", "group": "ma3@6" },
        { "command": "ma3.bank.favorite", "when": "view == ma3.varbank && (viewItem == ma3bankvar || viewItem == ma3bankstock)", "group": "ma3@0" },
        { "command": "ma3.bank.unfavorite", "when": "view == ma3.varbank && viewItem == ma3bankfav", "group": "ma3@0" },
        { "command": "ma3.bank.editFavorite", "when": "view == ma3.varbank && viewItem == ma3bankfav", "group": "ma3@1" },
        { "command": "ma3.bank.reveal", "when": "view == ma3.varbank && viewItem == ma3bankvar", "group": "ma3@2" }
      ],
      "editor/context": [
        { "command": "ma3.runOnConsole", "when": "editorLangId == lua", "group": "ma3" },
        { "command": "ma3.deploy", "when": "resourceExtname == .lua || resourceExtname == .xml", "group": "ma3" },
        { "command": "ma3.vars.replaceRange", "when": "editorLangId == lua || editorLangId == gma2macro || editorLangId == gma3macro", "group": "ma3vars@1" },
        { "command": "ma3.vars.preview", "when": "editorLangId == lua || editorLangId == gma2macro || editorLangId == gma3macro", "group": "ma3vars@2" },
        { "command": "ma3.vars.extract", "when": "(editorLangId == lua || editorLangId == gma2macro || editorLangId == gma3macro) && editorHasSelection", "group": "ma3vars@3" },
        { "command": "ma3.vars.convert", "when": "editorLangId == lua || editorLangId == gma2macro || editorLangId == gma3macro", "group": "ma3vars@4" },
        { "command": "ma3.bank.insert", "when": "editorLangId == lua || editorLangId == gma2macro || editorLangId == gma3macro", "group": "ma3vars@5" },
        { "command": "ma3.bank.favorite", "when": "editorLangId == lua || editorLangId == gma2macro || editorLangId == gma3macro", "group": "ma3vars@6" }
      ]
    },
    "configuration": {
      "title": "Devkit for Grand MA2+MA3",
      "properties": {
        "ma3.target": {
          "type": "string",
          "enum": ["auto", "ma3", "ma2"],
          "default": "auto",
          "markdownDescription": "Which console a Lua file is written for. `auto` picks grandMA2 when the code calls `gma.*` or the plugin's manifest is a grandMA2 one (`<MA ...>`), and grandMA3 otherwise."
        },
        "ma3.telnet.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host of the console's Telnet command line (grandMA2). Telnet (the remote command line) must be enabled on the console."
        },
        "ma3.telnet.port": {
          "type": "number",
          "default": 30000,
          "description": "Telnet command-line port."
        },
        "ma3.telnet.monitorPort": {
          "type": "number",
          "default": 30001,
          "description": "Telnet System Monitor port (Lua runtime errors and console messages)."
        },
        "ma3.telnet.user": {
          "type": "string",
          "default": "administrator",
          "description": "User profile to log in as over Telnet, for example a dedicated testing user. Many profiles have no password; if yours does, use Set Telnet Password (kept in VS Code's secret storage, never in settings)."
        },
        "ma3.telnet.gapMs": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "description": "Pause between Telnet commands in milliseconds; the console drops lines when they arrive faster."
        },
        "ma3.deployAndRun.via": {
          "type": "string",
          "enum": ["auto", "bridge", "telnet", "osc"],
          "default": "auto",
          "markdownDescription": "How **Deploy and Reload on Console** reaches the console: `auto` uses the LuaBridge when it is running, and otherwise Telnet (grandMA2) or OSC (grandMA3). OSC gives no confirmation."
        },
        "ma3.osc.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host of the grandMA3 console's OSC input."
        },
        "ma3.osc.port": {
          "type": "number",
          "default": 8000,
          "description": "UDP port of OSC line 1 on the console."
        },
        "ma3.osc.prefix": {
          "type": "string",
          "default": "",
          "description": "Prefix of OSC line 1 on the console; commands go to /<prefix>/cmd, or /cmd when empty."
        },
        "ma3.osc.gapMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "description": "Pause between OSC commands in milliseconds."
        },
        "ma3.bridge.slot": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Plugin pool slot **Install LuaBridge on Console** suggests for LuaBridge_MA2 (0 means 99)."
        },
        "ma3.test.timeout": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "markdownDescription": "CPU seconds a `*.test.lua` run may use on the console before the bridge stops it. The console UI is frozen that long."
        },
        "ma3.usb.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Stick (or folder) **Export Plugin to USB Stick** copies to, without asking. Empty lists the removable drives."
        },
        "ma3.ma2.pluginsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder grandMA2 loads plugin files from. Empty uses the newest `%ProgramData%/MA Lighting Technologies/grandma/gma2_V_<version>/plugins` on Windows."
        },
        "ma3.ma2.bridgeDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder the grandMA2 LuaBridge_MA2 plugin polls. Empty uses `%ProgramData%/MA2/luabridge` (or the `MA2_LUABRIDGE_DIR` environment variable). Use onPC with a throwaway show."
        },
        "ma3.ma2.version": {
          "type": "string",
          "default": "3.9.61",
          "description": "grandMA2 software version written into new grandMA2 plugin manifests (major.minor.stream)."
        },
        "ma3.pluginsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder the console loads plugin files from. Empty uses `%ProgramData%/MALightingTechnology/gma3_library/datapools/plugins` on Windows; set it on other systems or for a USB stick."
        },
        "ma3.deployOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Copy a plugin's files to the plugins folder whenever one of its .lua or .xml files is saved."
        },
        "ma3.deployAndRun.slot": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Plugin pool slot that **Deploy and Reload on Console** imports the plugin into and starts, through the LuaBridge plugin. 0 only deploys. Use onPC with a throwaway show: the slot is overwritten."
        },
        "ma3.dataVersion": {
          "type": "string",
          "default": "2.0.0.0",
          "description": "DataVersion written into new plugin XML manifests."
        },
        "ma3.bridge.dir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder the LuaBridge plugin polls. Empty uses `%ProgramData%/MA3/luabridge` (or the `MA3_LUABRIDGE_DIR` environment variable). Run only against onPC with a throwaway show: anything that can write this folder can run Lua in grandMA3."
        },
        "ma3.bridge.timeout": {
          "type": "number",
          "default": 2,
          "minimum": 0.1,
          "markdownDescription": "Seconds of CPU time a run may use before the bridge stops it. The console UI is frozen for that long, and time spent in `coroutine.yield` counts."
        },
        "ma3.liveCompletion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Inside `Cmd(\"...\")` strings, complete group, sequence, macro, preset and similar numbers with the labels from the show running in onPC, through the LuaBridge plugin. The lookup takes a few milliseconds of console time, at most once a minute, and only while the bridge is running."
        },
        "ma3.lint.globals": {
          "type": "boolean",
          "default": false,
          "description": "Hint when a variable is assigned without \"local\" and so becomes a global shared with every plugin."
        },
        "ma3.vars.watchIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "How often Watch Console Variables reads the console, in milliseconds."
        },
        "ma3.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Check plugin manifests and flag loops that never yield."
        }
      }
    }
  }
}
